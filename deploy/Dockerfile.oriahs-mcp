# Docker configuration for oriahs-mcp server (B-01, HTTP transport since B-02).
#
# The previous build ran `uv sync --no-dev` while the context only held
# pyproject.toml + uv.lock — hatchling could not build the project without
# README.md and app/, so the image never built at all. Dependencies are now
# synced with --no-install-project first (the server runs from the source tree
# via `python -m`), and the runtime python comes from /app/.venv/bin — the old
# image's CMD used the *system* python, which has no httpx/mcp installed.
#
# Same base as deploy/Dockerfile: uv preinstalled, python3.12 matches the
# repository venv (uv.lock is frozen).

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

ENV UV_FROZEN=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Dependency layer first: only pyproject/uv.lock change rarely.
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --no-install-project

# Project layer: the `app` package source (run via `python -m app.mcp.oriahs_mcp`,
# no editable install needed).
COPY app ./app

ENV PATH="/app/.venv/bin:$PATH"

# Non-root runtime user (parity with the original image).
RUN useradd --create-home --shell /bin/bash mcpuser
USER mcpuser

EXPOSE 8765

# Liveness of the HTTP transport (/health) — python, not curl: bookworm-slim
# ships no curl. Compose overrides this with an identical probe.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8765/health', timeout=5).status == 200 else 1)"

# HTTP transport by default (app/mcp/client.py REST contract); 0.0.0.0 so the
# compose port mapping and the sibling api container can reach it.
CMD ["python", "-m", "app.mcp.oriahs_mcp", "--host", "0.0.0.0", "--port", "8765"]
