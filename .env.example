# LLM Provider Configuration (M-01)
ORYA_LLM_PROVIDER=anthropic
ORYA_LLM_MODEL=claude-sonnet-3.5
ORYA_LLM_API_KEY=your_api_key_here
ORYA_LLM_BASE_URL=

# LLM generation defaults (M-02)
# ORYA_LLM_TEMPERATURE=0.0
# ORYA_LLM_MAX_TOKENS=8192
# ORYA_LLM_TIMEOUT_S=120

# Database Configuration (M-03)
DATABASE_URL=postgresql://orya:orya_password@localhost:5432/orya_sessions
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Redis Configuration (M-21)
REDIS_URL=redis://localhost:6379
# ORYA_CACHE_BACKEND=auto   # auto | memory | redis
# ORYA_CACHE_TTL_SECONDS=300

# Memory Directory (M-25)
ORYA_MEMORY_DIR=~/.orya/memory
# ORYA_MEMORY_COMPACT_INTERVAL_SECONDS=86400   # periodic L0 compaction (M-27); 0 = off

# Session-log JSONL projection (M-14)
# ORYA_SESSIONS_DIR=~/.orya/sessions

# Permission policy (M-13): strict | permissive
# ORYA_PERMISSION_POLICY=strict
# ORYA_PERMISSIONS_PATH=~/.orya/permissions.yml

# Agent loop (M-04): max agent-loop iterations
# ORYA_RECURSION_LIMIT=25

# Context window (M-06): history is trimmed to this budget before each model call
# ORYA_CONTEXT_MAX_TOKENS=120000

# Logging
LOG_LEVEL=INFO

# UI (M-15/M-24)
# CHAINLIT_PORT=8001
# ORYA_API_URL=http://127.0.0.1:8000   # FastAPI base URL the Chainlit UI calls (M-24)
# ORYA_UI_SETTINGS_PATH=~/.orya/settings.json

# Auth (ALPHA placeholder)
# AUTH_SECRET_KEY=
# AUTH_ALGORITHM=HS256

# Observability (ALPHA placeholder)
# LANGSMITH_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# OriaHS (PROD placeholder)
# ORIAHS_URL=
# ORIAHS_TIMEOUT_S=30


# Chinese providers (if available)
# DEEPSEEK_API_KEY=your_deepseek_key
# DASHSCOPE_API_KEY=your_qwen_key
# ZHIPUAI_API_KEY=your_glm_key
# MIMO_API_KEY=your_mimo_key
# MOONSHOT_API_KEY=your_moonshot_key
# OPENROUTER_API_KEY=your_openrouter_key

# Local providers
# ORYA_LLM_PROVIDER=ollama
# ORYA_LLM_MODEL=qwen2.5-coder:14b
# ORYA_LLM_BASE_URL=http://localhost:11434/v1
# ORYA_LLM_API_KEY=ollama

# ORYA_LLM_PROVIDER=lmstudio
# ORYA_LLM_MODEL=qwen2.5-coder-7b-instruct
# ORYA_LLM_BASE_URL=http://localhost:1234/v1
# ORYA_LLM_API_KEY=lm-studio

# ORYA_LLM_PROVIDER=vllm
# ORYA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# ORYA_LLM_BASE_URL=http://localhost:8000/v1
# ORYA_LLM_API_KEY=vllm