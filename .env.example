# LLM Provider Configuration (M-01)
ORYA_LLM_PROVIDER=anthropic
ORYA_LLM_MODEL=claude-sonnet-3.5
ORYA_LLM_API_KEY=your_api_key_here
ORYA_LLM_BASE_URL=

# LLM generation defaults (M-02)
# ORYA_LLM_TEMPERATURE=0.0
# ORYA_LLM_MAX_TOKENS=8192
# ORYA_LLM_TIMEOUT_S=120

# LLM seam tracing (A-02): llm.call span per get_llm() invocation
# ORYA_LLM_TRACE_ENABLED=true        # false = raw provider adapter, no spans
# ORYA_LLM_TRACE_EXPORTER=off        # off | stdout (debug JSON per span)

# Permission audit (A-03): agent.permission spans on permission decisions
# ORYA_PERMISSION_AUDIT_ENABLED=true  # false = no permission audit spans

# Database Configuration (M-03)
DATABASE_URL=postgresql://orya:orya_password@localhost:5432/orya_sessions
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Redis Configuration (M-21)
REDIS_URL=redis://localhost:6379
# ORYA_CACHE_BACKEND=auto   # auto | memory | redis
# ORYA_CACHE_TTL_SECONDS=300
# ORYA_CACHE_MAX_ENTRIES=1024  # MemoryCache LRU capacity; 0 = unlimited
# ORYA_REDIS_POOL_MAX_CONNECTIONS=10  # Redis client pool max connections
# ORYA_REDIS_SOCKET_TIMEOUT_SECONDS=5.0  # Redis client socket timeout in seconds

# Memory Directory (M-25)
ORYA_MEMORY_DIR=~/.orya/memory
# ORYA_MEMORY_COMPACT_INTERVAL_SECONDS=86400   # periodic L0 compaction (M-27); 0 = off

# Session-log JSONL projection (M-14)
# ORYA_SESSIONS_DIR=~/.orya/sessions

# Session-log encryption at rest (A-05): pgcrypto pgp_sym_encrypt for
# messages.content / messages.tool_calls. Off by default so dev/tests keep
# working; enable requires a >= 16 char key (fail-fast otherwise).
# ORYA_SESSION_LOG_ENCRYPTION_ENABLED=false
# ORYA_SESSION_LOG_ENCRYPTION_KEY=

# Permission policy (M-13): strict | permissive
# ORYA_PERMISSION_POLICY=strict
# ORYA_PERMISSIONS_PATH=~/.orya/permissions.yml

# Agent loop (M-04): max agent-loop iterations
# ORYA_RECURSION_LIMIT=25

# Context window (M-06): history is trimmed to this budget before each model call
# ORYA_CONTEXT_MAX_TOKENS=120000

# Deployment profile (A-12): prod refuses to boot unless AUTH_ENABLED,
# ORYA_RATE_LIMIT_ENABLED and a non-wildcard CORS_ORIGINS are set (fail-fast);
# validate with `orya config check`, inspect with `orya config show`.
# ORYA_ENV=dev

# Logging
LOG_LEVEL=INFO

# UI (M-15/M-24)
# CHAINLIT_PORT=8001
# ORYA_API_URL=http://127.0.0.1:8000   # FastAPI base URL the Chainlit UI calls (M-24)
# ORYA_UI_SETTINGS_PATH=~/.orya/settings.json

# Docker compose stack (A-10)
# COMPOSE_PROFILES=app,observability   # app: api+chainlit; observability: langfuse v3 + sampler-proxy
#                                     # unset (default) = infra only (postgres + redis), as before A-10
# ORYA_WORKSPACE=.                     # host dir bind-mounted to /workspace in the api container
# API_PORT=8000                        # host port of the compose api service
# LANGFUSE_PORT=3000                   # host port of the compose langfuse web UI
# SAMPLER_PROXY_PORT=4321              # host port of the compose sampler-proxy (OTLP/HTTP)
# SAMPLER_METRICS_PORT=9095            # host port of the sampler-proxy /metrics

# Auth (A-00): JWT (HS256) enforcement on all non-public endpoints
# AUTH_SECRET_KEY=                              # >= 32 chars, required when auth is on
# AUTH_ALGORITHM=HS256
# AUTH_ENABLED=false                            # kill-switch: Bearer-JWT required per request
# AUTH_TOKEN_TTL_S=86400                        # lifetime of `orya auth token` output
# AUTH_PUBLIC_PATHS=/health,/docs,/redoc,/openapi.json,/metrics
# CORS_ORIGINS=*                                # comma-separated list, e.g. http://localhost:8001

# Rate limit (A-01): per-user 60 rpm, /learn endpoints 10 rpm
# ORYA_RATE_LIMIT_ENABLED=false                # kill-switch: 429 + Retry-After per request
# ORYA_RATE_LIMIT_RPM=60                       # per-user requests-per-minute on every endpoint
# ORYA_RATE_LIMIT_LEARN_RPM=10                 # tighter per-user RPM for /learn (anti-abuse)
# ORYA_RATE_LIMIT_BACKEND=auto                 # auto | memory | redis (auto falls back without Redis)
# ORYA_TRUSTED_CLIENTS=                        # user ids or client IPs exempt from limiting

# Cost router (A-13): budget-based model degrade between turns
# ORYA_COST_ROUTER_ENABLED=false               # kill-switch: 70% degrade, 90% warning, 100% 429
# ORYA_COST_ROUTER_FALLBACK_MODEL=claude-haiku-3.5  # models.yaml alias used when degraded
# ORYA_COST_BUDGET_DEFAULT_USD=50.0            # daily per-identity budget (orya:limit:{id} overrides)
# ORYA_COST_BACKEND=auto                       # auto | memory | redis (spend-counter backend)

# Tiered router (A-18): tier-based model selection (env > tiered_router.models YAML > defaults)
# ORYA_TIERED_ROUTER_SMALL_MODEL=claude-haiku-3.5     # tier=small alias
# ORYA_TIERED_ROUTER_LARGE_MODEL=claude-sonnet-3.5    # tier=large alias (default tier)
# ORYA_TIERED_ROUTER_TOURNAMENT_MODEL=claude-sonnet-3.5  # tournament stub (degrades to large in ALPHA)

# Observability (ALPHA)
# LANGSMITH_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=          # generic OTLP collector base; wins over
#                                       # LANGFUSE_HOST and POSTs {endpoint}/v1/traces
# ORYA_SAMPLER_PROXY_URL=http://sampler-proxy:4321   # probed by /health/sampler-proxy (A-04)

# Langfuse OTLP export (A-15): active when HOST + both keys are set and the
# kill-switch is on (auto-on when configured). Spans POST to
# {LANGFUSE_HOST}/api/public/otel/v1/traces with Basic auth - that path works
# both against Langfuse directly and via the A-10 sampler-proxy.
# LANGFUSE_HOST=http://sampler-proxy:4321   # in the A-10 compose stack; direct Langfuse URL otherwise
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_DIRECT_URL=                    # fail-open fallback when the primary endpoint is down
# ORYA_LANGFUSE_EXPORT_ENABLED=true       # kill-switch: false = spans stay in-process only

# OryaObservability SDK (A-16): agent.loop/tool.call/memory.write spans +
# PII masking of span content. The agent-obs package is an OPT-IN install
# (uv pip install -e ../OryaObservability - light extras since sibling 22ee74c);
# without it content attrs fail-closed to [REDACTED:guardrail_unavailable].
# AGENT_OBS_ENABLED=true                  # A-16 span emission kill-switch (default true)
# AGENT_OBS_GUARDRAIL_ENABLED=true        # PII masking of task.input/tool io (default true)
# AGENT_OBS_SAMPLER_AUDIT_ENABLED=1       # sampler-proxy audit trail (A-17)
PROMETHEUS_URL=http://prometheus:9090     # sampler-proxy Prometheus scrape
PROMETHEUS_PORT=9090                      # host port for prometheus service
CLICKHOUSE_OBS_DB=observability           # ClickHouse database for audit events

# OriaHS (PROD placeholder)
# ORIAHS_URL=
# ORIAHS_TIMEOUT_S=30


# Chinese providers (if available)
# DEEPSEEK_API_KEY=your_deepseek_key
# DASHSCOPE_API_KEY=your_qwen_key
# ZHIPUAI_API_KEY=your_glm_key
# MIMO_API_KEY=your_mimo_key
# MOONSHOT_API_KEY=your_moonshot_key
# OPENROUTER_API_KEY=your_openrouter_key

# Local providers
# ORYA_LLM_PROVIDER=ollama
# ORYA_LLM_MODEL=qwen2.5-coder:14b
# ORYA_LLM_BASE_URL=http://localhost:11434/v1
# ORYA_LLM_API_KEY=ollama

# ORYA_LLM_PROVIDER=lmstudio
# ORYA_LLM_MODEL=qwen2.5-coder-7b-instruct
# ORYA_LLM_BASE_URL=http://localhost:1234/v1
# ORYA_LLM_API_KEY=lm-studio

# ORYA_LLM_PROVIDER=vllm
# ORYA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# ORYA_LLM_BASE_URL=http://localhost:8000/v1
# ORYA_LLM_API_KEY=vllm